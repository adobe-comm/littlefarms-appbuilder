{
  "plugins": [
    [
      "@babel/plugin-transform-react-jsx",
      {
        "runtime": "automatic",
        "development": false
      }
    ]
  ],
  "env": {
    "development": {
      "plugins": [
        [
          "@babel/plugin-transform-react-jsx",
          {
            "runtime": "automatic",
            "development": true
          }
        ]
      ]
    }
  }
}
