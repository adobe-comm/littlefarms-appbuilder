# Adobe Commerce / ACCS GraphQL (existing mesh source)
COMMERCE_ENDPOINT=https://na1-sandbox.api.commerce.adobe.com/<environment-id>/graphql

# App Builder web action URLs (after aio app deploy — no trailing slash)
LITTLEFARMS_BLOCK_STOREFRONT_URL=https://<namespace>.adobeioruntime.net/api/v1/web/littlefarms-appbuilder/block-storefront
LITTLEFARMS_BLOCK_EVALUATE_URL=https://<namespace>.adobeioruntime.net/api/v1/web/littlefarms-appbuilder/block-evaluate

# Same secret as EVALUATE_SHARED_SECRET in the App Builder .env (mesh holds it; never expose to the browser)
EVALUATE_SHARED_SECRET=
