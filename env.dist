# Runtime logging level: error, warn, info, or debug.
LOG_LEVEL=info

# Adobe Commerce as a Cloud Service Catalog Service GraphQL endpoint.
COMMERCE_GRAPHQL_URL=

# Optional local override for ACCS GraphQL (admin catalog lookups).
# In deployed environments, set this in App Management → Business Configuration
# (field: Commerce GraphQL endpoint / COMMERCE_CORE_GRAPHQL_URL) during install.
# Example: https://na1-sandbox.api.commerce.adobe.com/<environment-id>/graphql
COMMERCE_CORE_GRAPHQL_URL=

# Optional local override for ACCS REST (orders). Set in App Management → Business Configuration
# (field: Commerce REST API base / COMMERCE_CORE_REST_URL) during Admin UI SDK install.
# Example: https://na1-sandbox.api.commerce.adobe.com/<environment-id>/V1
COMMERCE_CORE_REST_URL=

# Optional Commerce context for GraphQL headers (blocks are stored globally per environment, not per store view).
MAGENTO_STORE_CODE=
MAGENTO_WEBSITE_CODE=
MAGENTO_ENVIRONMENT_ID=
MAGENTO_CUSTOMER_GROUP=
# Optional. The ACCS GraphQL endpoint uses "not_used" when this is empty.
MAGENTO_API_KEY=

# Adobe IMS server-to-server credentials used for Catalog Service and Database.
IMS_ORG_ID=
IMS_CLIENT_ID=
IMS_CLIENT_SECRETS=
IMS_SCOPES=

# Business configuration library (required on runtime when commerce/configuration/1 is deployed).
# Generate locally: npx aio-commerce-lib-config encryption setup
# Set the same value in App Builder workspace secrets for deploy.
AIO_COMMERCE_CONFIG_ENCRYPTION_KEY=

# App Management service credentials generated for the Commerce extension.
AIO_COMMERCE_AUTH_IMS_CLIENT_ID=
AIO_COMMERCE_AUTH_IMS_CLIENT_SECRETS=
AIO_COMMERCE_AUTH_IMS_TECHNICAL_ACCOUNT_ID=
AIO_COMMERCE_AUTH_IMS_TECHNICAL_ACCOUNT_EMAIL=
AIO_COMMERCE_AUTH_IMS_ORG_ID=
AIO_COMMERCE_AUTH_IMS_SCOPES=

# Random credential sent only by API Mesh or the storefront server (block-storefront + block-evaluate).
# Configure the same value in API Mesh env — see api-mesh/sample.env.
EVALUATE_SHARED_SECRET=

# App Builder State and Database regions: amer, emea, apac, or aus.
STATE_REGION=amer
DB_REGION=amer

# Product evaluation cache lifetime in seconds (PDP block-evaluate).
EVAL_CACHE_TTL=300

# Storefront condition → SKU list cache in seconds (API Mesh / block-storefront).
# Brand storefront reads (brand-storefront) use this same TTL. There is no separate brand attribute code here.
PRESET_RESULT_CACHE_TTL=600

# Storefront actions (block, brand, location, blog): State SWR fresh window, then stale-while-revalidate (seconds).
# Legacy aliases BLOG_STOREFRONT_CACHE_FRESH_SECONDS / BLOG_STOREFRONT_CACHE_SWR_SECONDS still work for blog only.
STOREFRONT_CACHE_FRESH_SECONDS=60
STOREFRONT_CACHE_SWR_SECONDS=3600

# API Mesh secret LITTLEFARMS_DELIVERY_SLOT_STOREFRONT_URL points at delivery-slot-storefront (see api-mesh/secrets.yaml).
# Optional: store timezone for slot cutoffs and daily reset (default Asia/Singapore).
# DELIVERY_SLOT_TIMEZONE=Asia/Singapore
